      <column caption='Calculation1' datatype='real' name='[Calculation_305118940112596992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Multimodal Percentage = SUM([mod_multimodal]) / COUNT([tool_name])' />
      </column>
      <column caption='Multimodal Percentage' datatype='real' name='[Calculation_305118940118437889]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([mod_multimodal]) / COUNT([tool_name])' />
      </column>
      <column caption='Open Source Label' datatype='string' name='[Calculation_305118940145872898]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [open_source] = 1 THEN &quot;Open Source&quot;&#13;&#10;ELSE &quot;Proprietary&quot;&#13;&#10;END' />
      </column>
      <column caption='API Availability %' datatype='real' name='[Calculation_86975833470566400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([api_available]) / COUNT([tool_name])' />
      </column>
      <column caption='Open Source %' datatype='real' name='[Calculation_86975833479598081]' role='measure' type='quantitative'>
